# ============================================================
# 財務安全チェッカー — 環境変数テンプレート
# このファイルをコピーして .env を作成し、各値を設定してください
# ============================================================

# ── AI解説（任意）────────────────────────────────────────────
# 設定するとくまちゃんのAI解説が有効になります（なくても動作します）
# 取得先: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-xxxx

# ── Supabase（認証・使用量管理に必要）──────────────────────
# 取得先: https://supabase.com/ > プロジェクト設定 > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe（決済に必要）────────────────────────────────────
# 取得先: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PRICE_ID=price_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxx

# ── アプリURL（Stripe success_urlに使用）──────────────────
APP_URL=https://zaimu-checker.onrender.com